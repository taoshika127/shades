{
  "name": "light-shade",
  "version": "1.0.0",
  "description": "Pacific Light Shades E-commerce Website",
  "scripts": {
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "wait-on http://localhost:5001 -t 30000 && cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "cd backend && npm start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "baseline-browser-mapping": "^2.9.16",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}
