{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/book",
      "destination": "https://calendly.com/becky-pacificlightshades/pacific-light-shades-in-home-consultation",
      "statusCode": 301
    },
    {
      "source": "/book/",
      "destination": "https://calendly.com/becky-pacificlightshades/pacific-light-shades-in-home-consultation",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://shades-production.up.railway.app/api/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://shades-production.up.railway.app/assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

